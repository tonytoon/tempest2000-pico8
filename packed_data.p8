-- build direct record-pointer tables once at startup
function add_data(t,a,i,n)
 for j=0,n-1 do
  t[i+j]=a
  a+=@a+1
 end
end
verts_data={}
cmds_data={}
meta_data={}
waves_data={}
messages_data={}

function get_message(i)
 local a=unpack_addr(messages_data[i])
 return chr(peek(a,@(a-1)))
end

function init_packed_data()
 add_data(verts_data,0x0000,V_WEB1,32)
 add_data(verts_data,0x023A,V_TANKER,49)
 add_data(verts_data,0x10B4,V_CHAR_A,45)
 add_data(cmds_data,0x0A8B,C_TANKER,34)
 for i=C_PUTANKER2,C_PUTANKER6 do cmds_data[i]=0x0D7D end
 add_data(cmds_data,0x0DB0,C_REFSHOT,10)
 add_data(cmds_data,0x2D30,C_CHAR_A,45)
 add_data(meta_data,0x232D,M_WEB1,32)
 add_data(waves_data,0x2576,W_WAVE01,100)
 add_data(messages_data,0x16B0,S_COLLECT_POWERUPS,23)
end
